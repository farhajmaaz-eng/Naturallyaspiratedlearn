# Optional: configure one shared server-side key.
# Leave blank to let each user add their own key in Settings.
OPENROUTER_API_KEY=

# OpenRouter model identifier used when the browser has no override.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: protect the whole workspace with one password.
# When blank, the app opens without a sign-in screen.
APP_PASSWORD=

# SQLite database location. The directory is created automatically.
DATABASE_PATH=data/study.db

# Public URL sent to OpenRouter in the HTTP-Referer header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
